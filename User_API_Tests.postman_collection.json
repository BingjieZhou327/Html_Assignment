    {
      "name": "6. Get All Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has users array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.users).to.be.an('array');",
              "    pm.expect(jsonData.users.length).to.be.at.least(1);",
              "});",
              "",
              "pm.test(\"Users have required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.users.forEach(function(user) {",
              "        pm.expect(user).to.have.property('fullName');",
              "        pm.expect(user).to.have.property('email');",
              "        pm.expect(user).to.have.property('password');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
